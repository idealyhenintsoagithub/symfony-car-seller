{% extends 'admin/admin-layout.html.twig' %}

{% block title %}Produits{% endblock %}

{% set actions = [
    {'path': 'app_product_new', 'label': 'Crée une produit', 'iconClass': 'bi bi-plus-lg'},
] %}

{% set titleStyle = { width: '15%' } %}
{% set descriptionStyle = { width: '15%' } %}
{% set stockStyle = { width: '15%' } %}
{% set priceStyle = { width: '15%' } %}
{% set typeStyle = { width: '15%' } %}
{% set brandStyle = { width: '15%' } %}
{% set genderStyle = { width: '15%' } %}
{% set actionsStyle = { width: '15%' } %}

{% block body %}
    <h1>Listes des products</h1>
    {{ include("shared/page-actions.html.twig", { actions: actions }) }}
    <div class="custom-page-content p-2">
        <table class="table table-hover" style="width: 100%;">
            <thead>
                <tr>
                    <th style="width: 10%;">Titre</th>
                    <th style="width: 15%;">Description</th>
                    <th style="width: 15%;">Nbr stock</th>
                    <th style="width: 10%;">Prix (TTC)</th>
                    <th style="width: 15%;">Type</th>
                    <th style="width: 15%;">Marque</th>
                    <th style="width: 10%;">Genre</th>
                    <th style="width: 10%;">actions</th>
                </tr>
            </thead>
            <tbody>
            {% for product in products %}
                <tr>
                    <td style="width: 10%; white-space: nowrap;" >{{ product.title }}</td>
                    <td class="table-wrap" style="width: 200px;">
                      <div
                        data-bs-toggle="tooltip"
                        data-bs-placement="bottom"
                        data-bs-title="{{ product.description }}"
                      >
                        {{ product.description }}
                      </div>
                    </td>
                    <td style="width: 15%;" class="text-right">{{ product.stock }}</td>
                    <td style="width: 10%;" class="text-right">{{ product.priceTtc }}</td>
                    <td style="width: 15%;">{{ product.type }}</td>
                    <td style="width: 15%;">
                        {% if product.brand.logo is defined %}
                            <a href="{{ path('app_vendor_show', {'id': product.brand.id }) }}">
                                {{
                                    include("shared/table-image.html.twig", {
                                        "imagePath": "images/vendors/" ~ product.brand.logo 
                                    })
                                }}
                            </a>
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td style="width: 10%;">{{ product.gender }}</td>
                    <td style="width: 10%;">
                        {{ include("product/actions.html.twig", { product: product }) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
