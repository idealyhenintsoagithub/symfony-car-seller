{% extends 'admin/admin-layout.html.twig' %}

{% block title %}Product{% endblock %}

{% set actions = [
    { 
        'path': 'app_product_index', 
        'label': 'Liste des produits', 
        'iconClass': "bi bi-list-task"
    },
    { 
        'path': 'app_product_edit', 
        'label': 'Modifier', 
        'iconClass': "bi bi-pencil",
        'variables': product.id
    },
] %}

{% block body %}
    <h1>Detail du produit</h1>

    {{ include("shared/page-actions.html.twig", { actions: actions }) }}
    <div class="custom-page-content p-2">
        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ product.id }}</td>
                </tr>
                <tr>
                    <th>Title</th>
                    <td>{{ product.title }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ product.description }}</td>
                </tr>
                <tr>
                    <th>Stock</th>
                    <td>{{ product.stock }}</td>
                </tr>
                <tr>
                    <th>PriceTtc</th>
                    <td>{{ product.priceTtc }}</td>
                </tr>
                <tr>
                    <th>Type</th>
                    <td>{{ product.type }}</td>
                </tr>
                <tr>
                    <th>Gender</th>
                    <td>{{ product.gender }}</td>
                </tr>
            </tbody>
        </table>
    </div>
    <a href="{{ path('app_product_edit', {'id': product.id}) }}">edit</a>

    {{ include('product/_delete_form.html.twig') }}
{% endblock %}
