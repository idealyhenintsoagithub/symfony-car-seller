{% extends 'admin/admin-layout.html.twig' %}

{% block title %}Fournisseurs{% endblock %}

{% block body %}
    <h1>Fournisseurs</h1>
    <div class="custom-page-content p-2">
        <table class="table">
            <thead>
                <tr>
                    <th>Logo</th>
                    <th>Nom</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for vendor in vendors %}
                <tr>
                    <td>
                        <img 
                          src={{ asset("/images/vendors/" ~ vendor.logo) }} 
                          alt={{ vendor.logo }}
                          width="50"
                        >
                    </td>
                    <td>{{ vendor.name }}</td>
                    <td>
                        <a href="{{ path('app_vendor_show', {'id': vendor.id}) }}">show</a>
                        <a href="{{ path('app_vendor_edit', {'id': vendor.id}) }}">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>  
{% endblock %}
