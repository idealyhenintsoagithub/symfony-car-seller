{% extends 'admin/admin-layout.html.twig' %}

{% block title %}Admin!{% endblock %}

{% set orderAccountData = [20, 30, 90, 40] %}

{% set orderAccountLabel = [2010, 2011, 2012, 2013] %}

{% set imgStyle = 'width: 50px; border-radius: 50%;' %}

{% macro imageContainerAttr(left) %}
  class="rounded-5 bg-white p-1 border"
  style="position: relative; left: {{ left }}; width: 50px;"
{% endmacro %}

{% block pageCustomContents %}
  <div class="container my-5 px-4">
    <div class="row gx-4">
      <div class="col-sm-3 ps-0">
        <div class="custom-page-content d-flex justify-content-between align-items-center rounded-3">
          <div class="w-100 p-4 d-flex justify-content-between flex-column">
            <div class="pb-3 fs-6">Utilisateurs</div>
            <div class="d-flex align-items-center justify-contents-between" style="height: 50px;">
              <div {{ _self.imageContainerAttr(0) }}>
                <img
                  src="{{ asset('/images/avatar-1.jpg') }}"
                  alt="avatar"
                  style="{{ imgStyle }}"
                >
              </div>
              <div {{ _self.imageContainerAttr('-30px') }}>
                <img src="{{ asset('/images/avatar-1.jpg') }}" alt="avatar" style="{{imgStyle}}">
              </div>
              <div {{ _self.imageContainerAttr('-60px') }}>
                <img src="{{ asset('/images/avatar-1.jpg') }}" alt="avatar" style="{{imgStyle}}">
              </div>
              <div {{ _self.imageContainerAttr('-90px') }}>
                <img src="{{ asset('/images/avatar-1.jpg') }}" alt="avatar" style="{{imgStyle}}">
              </div>
              <div class="fs-4 fw-bold">{{ userTotal }}</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-sm-3 bg-white rounded-3 p-4">
        <div class="pb-3 fs-6">Clients</div>
        <div class="d-flex justify-content-between align-items-center" style="height: 50px;">
          <div class="fs-4 fw-bold">{{ userTotal }}</div>
          <i class="bi bi-people-fill" style="font-size: 30px;"></i>
        </div>
      </div>
      <div class="col-sm-3">
        <div class="rounded-3 bg-white p-4">
          <div class="pb-3 fs-6">Commande</div>
          <div class="d-flex justify-content-between align-items-center" style="height: 50px;">
            <div class="fs-4 fw-bold">{{ totalOrderValues }}</div>
            <i class="bi bi-cart-fill" style="font-size: 30px;"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="row mt-4">
      <div class="col-sm-8 p-0">
        <div class="bg-white p-4 rounded-3">
          <canvas id="productPerVendor" data-data="{{ productPerVendor|serialize(format = 'json') }}"></canvas>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="rounded-3 bg-white">
          <div class="fs-6 fw-bold px-4 py-3 border-bottom text-primary">Commandes recent</div>
          {% for order in orders %}
            <div class="d-flex p-4 border-bottom align-items-center">
              <img src="{{ asset('/images/avatar-1.jpg') }}" alt="avatar" style="{{imgStyle}}">
              <div class="ps-3">
                <div class="fw-bold">{{ order.client.lastName }}</div>
                <div class="fw-bold">{{ order.client.firstName }}</div>
                <div class="fw-light fst-italic">Le : {{ order.createdAt|date('d/M/Y') }}</div>
              </div>
              <div class="flex-grow-1 text-end fw-bold">${{ order.total|number_format(2, '.', ' ') }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block pageContentAttr %} class="d-none" {% endblock %}
