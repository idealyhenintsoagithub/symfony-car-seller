{% trans_default_domain 'admin' %}

<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
    {% block stylesheets %}
      {{ encore_entry_link_tags('app') }}
      {{ encore_entry_link_tags('admin_app') }}
    {% endblock %}

    {% block javascripts %}
      {{ encore_entry_script_tags('app') }}
      {{ encore_entry_script_tags('admin_app') }}
    {% endblock %}
  </head>
  <body>
    <div class="container-fluid d-flex p-0">
      {{ include('admin/sidebar.html.twig') }}
      <div class="page-content col p-3 ps-0">
        <h3 class="py-4">{% block pageTitle %}{% endblock %}</h3>

        <div>{% block pageSubHeader %}{% endblock %}</div>

        <div>{% block pageActions %}{% endblock %}</div>

        <div>{% block pageCustomContents %}{% endblock %}</div>
  
        <div {% block pageContentAttr %} class="rounded-4 custom-page-content p-3" {% endblock %}>
          {% block body %}{% endblock %}
        </div>
      </div>
    </div>
  </body>
</html>
