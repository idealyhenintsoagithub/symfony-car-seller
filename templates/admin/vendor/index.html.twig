{% trans_default_domain 'admin' %}

{% extends 'admin/admin-layout.html.twig' %}

{% block title %}Fournisseurs{% endblock %}

{% set actions = [
    {'path': 'app_vendor_new', 'label': 'Crée un fournisseur', 'iconClass': 'bi bi-plus-lg'},
] %}

{% macro formatBrand(data, column, content) %}
  {{ include("shared/table-image.html.twig", { "imagePath": "images/vendors/" ~ content }) }}
{% endmacro %}

{% macro format(data, column, content) %}
  {% if column.name == 'logo' %}
    {{ _self.formatBrand(data, column, content) }}
  {% endif %}
{% endmacro %}

{% set datatableProps = {
  formatContentPath: '/vendor/index.html.twig',
} %}

{% set columns = [
  {
    name: 'logo',
    title: 'Logo',
    formatContent: true,
  },
  {
    name: 'name',
    title: 'Nom du fournisseur'
  },
  {
    name: 'actions',
    title: 'Actions',
    actions: [
      {
        'path': 'app_vendor_show',
        'label': 'Voire',
        'iconClass': 'bi bi-eye',
      },
      {
        'path': 'app_vendor_edit',
        'label': 'Modifier',
        'iconClass': 'bi bi-pencil',
      },
      {
        'path': 'app_vendor_delete',
        'label': 'Supprimer',
        'iconClass': 'bi bi-trash',
      },
    ],
  },
] %}

{% block pageTitle %}{{ 'title.vendor'|trans }}{% endblock %}

{% block pageActions %}
  {{ include("shared/page-actions.html.twig", { actions: actions }) }}
{% endblock %}

{% block body %}
  {{ include('core/datatable.html.twig', {
    columns: columns,
    data: vendors,
    datatableProps: datatableProps,
  }) }}
{% endblock %}
