{% trans_default_domain 'admin' %}

{% extends 'admin/admin-layout.html.twig' %}

{% block title %}Detail fournisseur{% endblock %}

{% set actions = [
    { 
        'path': 'app_vendor_index', 
        'label': 'Liste des fournisseurs', 
        'iconClass': 'bi bi-list' 
    },
    {
        'path': 'app_vendor_edit',
        'label': 'Modifier',
        'iconClass': 'bi bi-pencil',
        'variables': vendor.id
    }
] %}

{% block pageTitle %}{{ 'vendor.title.detail'|trans }}{% endblock %}

{% block pageActions %}
  {{ include("shared/page-actions.html.twig", { actions: actions }) }}  
{% endblock %}

{% block body %}
  <table class="table p-2">
    <tbody>
      <tr>
        <th>{{ 'vendor.label.logo'|trans }}</th>
        <td>
          {{ include("shared/table-image.html.twig", { 'imagePath': '/images/vendors/' ~ vendor.logo }) }}
        </td>
      </tr>
      <tr>
        <th>{{ 'vendor.label.name'|trans }}</th>
        <td>{{ vendor.name }}</td>
      </tr>
    </tbody>
  </table>
{% endblock %}
