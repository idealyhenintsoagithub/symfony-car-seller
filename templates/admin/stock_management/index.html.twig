{% trans_default_domain 'admin' %}

{% extends 'admin/admin-layout.html.twig' %}

{% block title %}Gestion des stock{% endblock %}

{% set columns = [
  {
    name: 'title',
    title: 'Nom du produit',
  },
  {
    name: 'stock',
    title: 'Nombre de stock',
    textAlign: 'text-end',
  },
  {
    name: 'actions',
    title: 'Actions',
    actions: [
      {
        path: 'app_stock_management_add',
        label: 'Modifier',
        iconClass: 'bi bi-pencil',
      },
      {
        path: 'app_stock_management_remove',
        label: 'Supprimer',
        iconClass: 'bi bi-trash',
      },
    ]
  }
] %}

{% block pageTitle %}{{ 'title.stockManagement'|trans }}{% endblock %}

{% block body %}
  <div>
    {{ include('/core/datatable.html.twig', {columns: columns, data: products}) }}
  </div>
{% endblock %}
