{% trans_default_domain 'admin' %}

{% extends 'admin/admin-layout.html.twig' %}

{% block title %}Commande{% endblock %}

{% set columns = [
  {
    name: 'clientName',
    field: 'client.firstName',
    title: 'Client',
  },
  {
    name: 'clientEmail',
    field: 'client.email',
    title: 'Email client',
  },
  {
    name: 'createdAt',
    title: 'Date de commande',
    textAlign: 'text-center',
  },
  {
    name: 'total',
    title: 'Cout totale',
    type: 'number',
    textAlign: 'text-end',
  },
  {
    name: 'actions',
    title: 'Actions',
    width: '100px',
    actions: [
      {
        'path': 'app_order_details',
        'label': 'Voire',
        'iconClass': 'bi bi-eye',
      },
    ]
  }
] %}

{% block pageTitle %}{{ 'title.order'|trans }}{% endblock %}

{% block body %}
  {{ include('core/datatable.html.twig', {columns: columns, data: orders}) }}
{% endblock %}
