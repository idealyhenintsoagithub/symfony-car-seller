<form 
    method="post" 
    action="{{ path('app_product_delete', {'id': product.id}) }}" 
    onsubmit="return confirm('Souhaidez vous supprimer cette produit? (Desoler pour l\'inteface)');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
    <button class="btn">
        <i class="bi bi-trash"></i>
        <span class="pl-2">Supprimer</span>
    </button>
</form>
