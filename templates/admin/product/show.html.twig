{% trans_default_domain 'admin' %}

{% extends 'admin/admin-layout.html.twig' %}

{% block title %}Product{% endblock %}

{% set actions = [
    { 
        'path': 'app_product_index', 
        'label': 'Liste des produits', 
        'iconClass': "bi bi-list-task"
    },
    { 
        'path': 'app_product_edit', 
        'label': 'Modifier', 
        'iconClass': "bi bi-pencil",
        'variables': product.id
    },
] %}

{% block pageTitle %}{{ 'product.title.detail'|trans }}{% endblock %}

{% block pageActions %}
  {{ include("shared/page-actions.html.twig", { actions: actions }) }}
{% endblock %}

{% block body %}
  <table class="table">
    <tbody>
      <tr>
          <th>Titre</th>
          <td>{{ product.title }}</td>
      </tr>
      <tr>
          <th>Description</th>
          <td>{{ product.description }}</td>
      </tr>
      <tr>
          <th>Nombre en stock</th>
          <td>{{ product.stock }}</td>
      </tr>
      <tr>
          <th>Prix(TTC)</th>
          <td>{{ product.priceTtc|number_format(2, '.', ' ') }}</td>
      </tr>
      <tr>
          <th>Type</th>
          <td>{{ product.type }}</td>
      </tr>
      <tr>
            <th>Genre</th>
            <td>{{ product.gender }}</td>
        </tr>
    </tbody>
  </table>
{% endblock %}
