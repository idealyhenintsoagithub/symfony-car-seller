{% trans_default_domain 'admin' %}

{% extends 'admin/admin-layout.html.twig' %}

{% block title %}Produits{% endblock %}

{% set actions = [
  {path: 'app_product_new', label: 'Crée une produit', 'iconClass': 'bi bi-plus-lg'},
] %}

{% set titleStyle = { width: '15%' } %}
{% set descriptionStyle = { width: '15%' } %}
{% set stockStyle = { width: '15%' } %}
{% set priceStyle = { width: '15%' } %}
{% set typeStyle = { width: '15%' } %}
{% set brandStyle = { width: '15%' } %}
{% set genderStyle = { width: '15%' } %}
{% set actionsStyle = { width: '15%' } %}

{% macro formatBrand(data, column, content) %}
  {{ include("shared/table-image.html.twig", { "imagePath": "images/logos/original/" ~ content }) }}
{% endmacro %}

{% macro format(data, column, content) %}
  {% if column.name == 'description' %}
    <div
      data-bs-toggle="tooltip"
      data-bs-placement="bottom"
      data-bs-title="{{ content }}"
    >
      {{ content }}
    </div>
  {% endif %}

  {% if column.name == 'brand' %}
    {{ _self.formatBrand(data, column, content) }}
  {% endif %}
{% endmacro %}

{% set datatableProps = {
  formatContentPath: 'admin/product/index.html.twig',
} %}

{% set columns = [
  {
      name: 'title',
      title: 'Titre',
      width: '100px',
  },
  {
      name: 'description',
      title: 'Description',
      formatContent: true,
      width: '100px',
      class: 'table-wrap',
  },
  {
      name: 'stock',
      title: 'Nbr stock',
      width: '100px',
      textAlign: 'text-end',
  },
  {
      name: 'priceTtc',
      title: 'Prix TTC',
      width: '100px',
      type: 'number',
      textAlign: 'text-end',
  },
  {
      name: 'brand',
      field: 'logo',
      title: 'Marque',
      width: '100px',
      formatContent: true,
      textAlign: 'text-center',
  },
  {
      name: 'actions',
      title: 'Actions',
      width: '100px',
      actions: [
        {
          'path': 'app_product_show',
          'label': 'Voire',
          'iconClass': 'bi bi-eye',
        },
        {
          'path': 'app_product_edit',
          'label': 'Modifier',
          'iconClass': 'bi bi-pencil',
        },
        {
          'path': 'app_product_delete',
          'label': 'Supprimer',
          'iconClass': 'bi bi-trash',
        },
    ]
  }
] %}

{% block pageTitle %}{{ 'title.product'|trans([], 'admin') }}{% endblock %}

{% block pageActions %}
    {{ include("shared/page-actions.html.twig", { actions: actions }) }}
{% endblock %}

{% block body %}
  <div>
    {{ include('/core/datatable.html.twig', {
      columns: columns,
      data: products,
      datatableProps: datatableProps,
    }) }}
  </div>
{% endblock %}
