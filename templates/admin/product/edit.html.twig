{% trans_default_domain 'admin' %}

{% extends 'admin/admin-layout.html.twig' %}

{% block title %}Modification produit{% endblock %}

{% set actions = [
  { 
    path: 'app_product_index', 
    label: 'Liste des produits', 
    iconClass: 'bi bi-list-task',
  }
] %}

{% block pageTitle %}{{ 'product.title.edit'|trans }}{% endblock %}

{% block pageActions %}
    {{ include("shared/page-actions.html.twig", { actions: actions }) }}
{% endblock %}

{% block body %}
  <div class="custom-page-content p-2">
      {{ include('admin/product/_form.html.twig', {'button_label': 'Mettre a jour'}) }}
  </div>
{% endblock %}
