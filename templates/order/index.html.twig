{% trans_default_domain 'admin' %}

{% extends 'admin/admin-layout.html.twig' %}

{% block title %}Commande{% endblock %}

{% set columns = [
  {
    name: 'clientName',
    field: 'client.firstName',
    title: 'Client',
  },
  {
    name: 'clientEmail',
    field: 'client.email',
    title: 'Email client',
  },
  {
    name: 'createdAt',
    title: 'Date de commande',
    textAlign: 'text-center',
  },
  {
    name: 'total',
    title: 'Cout totale',
    textAlign: 'text-end',
  },
] %}

{% block pageTitle %}{{ 'title.order'|trans }}{% endblock %}

{% block body %}
  {{ include('core/datatable.html.twig', {columns: columns, data: orders}) }}
{% endblock %}
