{% set continents = ['all', 'europe', 'america', 'asia', 'afrique'] %}

<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" href={{ path('app_home') }}>
      {{ 'home.title.pageName'|trans }}
    </a>
    <ul class="navbar-nav col-lg-6">
      <li class="nav-item">
        <a class="nav-link active" aria-current="page" href="{{ path('app_home') }}">Acceuil</a>
      </li>
      <li class="nav-item">
        <a
          class="nav-link active supplier-navlink"
          aria-current="page"
          role="button"
        >
          {{ 'navbar.supplier'|trans }}
        </a>
      </li>
      <li class="nav-item">
        <a
          class="nav-link models-navlink"
          aria-current="page"
          role="button"
        >
          {{ 'navbar.models'|trans }}
        </a>
      </li>
      {% if is_granted("ROLE_SUPER_ADMIN") %}
        <li class="nav-item">
          <a class="nav-link" href={{ path("app_admin") }}>
            {{ 'navbar.admin'|trans }}
          </a>
        </li>
      {% endif %}
    </ul>
    <div class="d-lg-flex col-lg-3 justify-content-lg-end">
      <div class="m-2">
        <a href="{{ path('app_cart') }}">
          <i class="bi bi-cart3 fs-5 text-dark"></i>
        </a>
      </div>
      <div class="m-2">
      {% if app.user %}
        <div class="dropdown">
          <button 
            class="btn dropdown-toggle p-0" 
            type="button" 
            data-bs-toggle="dropdown" 
            aria-expanded="false"
          >
            <i class="bi bi-person-circle fs-5"></i>
            {{ app.user.email }}
          </button>
          <ul class="dropdown-menu border shadow-sm">
            <li>
              <a 
                class="dropdown-item d-flex align-items-center p-2" 
                href={{ path('app_client_order') }}
              >
                <i class="bi bi-bag-check ps-3"></i>
                <div class="px-3">Ma commande</div>
              </a>
            </li>
            <li>
              <a 
                class="dropdown-item d-flex align-items-center p-2" 
                href={{ path('app_logout') }}
              >
                <i class="bi bi-box-arrow-right ps-3"></i>
                <div class="px-3">Deconnexion</div>
                </div> 
              </a>
            </li>
          </ul>
        </div>
      {% else %}
        <a href="{{ path('app_login') }}" class="text-dark text-decoration-none">
          <i class="bi bi-box-arrow-in-left fs-5 text-dark pl-2"></i>
          Sign-in
        </a>
      {% endif %}
      </div>
    </div>
  </div>
</nav>

{{ include('layout/brand_by_continents.html.twig') }}

<div class="p-2" id="models-menu">
  <div class="d-flex">
  </div>
</div>