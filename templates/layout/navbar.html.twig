{% set continents = ['Tout', 'Europe', 'Amerique', 'Asie', 'Afrique'] %}

<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" href={{ path('app_home') }}>
      {{ 'home.title.pageName'|trans }}
    </a>
    <ul class="navbar-nav col-lg-6">
      <li class="nav-item">
        <a class="nav-link active" aria-current="page" href="{{ path('app_home') }}">Acceuil</a>
      </li>
      <li class="nav-item">
        <a
          class="nav-link active supplier-navlink"
          aria-current="page"
          role="button"
        >
          {{ 'navbar.supplier'|trans }}
        </a>
      </li>
      <li class="nav-item">
        <a
          class="nav-link models-navlink"
          aria-current="page"
          role="button"
        >
          {{ 'navbar.models'|trans }}
        </a>
      </li>
      {% if is_granted("ROLE_SUPER_ADMIN") %}
        <li class="nav-item">
          <a class="nav-link" href={{ path("app_admin") }}>
            {{ 'navbar.admin'|trans }}
          </a>
        </li>
      {% endif %}
    </ul>
    <div class="d-lg-flex col-lg-3 justify-content-lg-end">
      <div class="m-2">
        <a href="{{ path('app_cart') }}">
          <i class="bi bi-cart3 fs-5 text-dark"></i>
        </a>
      </div>
      <div class="m-2">
      {% if app.user %}
        <div class="dropdown">
          <button 
            class="btn dropdown-toggle p-0" 
            type="button" 
            data-bs-toggle="dropdown" 
            aria-expanded="false"
          >
            <i class="bi bi-person-circle fs-5"></i>
            {{ app.user.email }}
          </button>
          <ul class="dropdown-menu">
            <li>
              <a 
                class="dropdown-item d-flex align-items-center px-2" 
                href={{ path('app_logout') }}
              >
                <i class="bi bi-box-arrow-right fs-5 m-1"></i>
                <div class="m-1">Ma commande</div>
              </a>
            </li>
            <li>
              <a 
                class="dropdown-item d-flex align-items-center px-2" 
                href={{ path('app_logout') }}
              >
                <i class="bi bi-box-arrow-right fs-5 m-1"></i>
                <div class="m-1">Deconnexion</div>
                </div> 
              </a>
            </li>
          </ul>
        </div>
      {% else %}
        <a href="{{ path('app_login') }}" class="text-dark text-decoration-none">
          <i class="bi bi-box-arrow-in-left fs-5 text-dark pl-2"></i>
          Sign-in
        </a>
      {% endif %}
      </div>
    </div>
  </div>
</nav>
<div class="p-2 d-none" id="supplier-menu">
  <div class="container">
    <div class="row">
      <div class="row col-md-8 border-end">
          {% for supplier in suppliers %}
            <div class="col-md-2 text-center g-3">
              <a href="{{ url('products_by_category', {'categoryName': supplier.name}) }}">
                <img
                  src="{{ asset('images/vendors/' ~ supplier.logo) }}"
                  alt="{{ supplier.name }}"
                  style="width: 50px; height: 50px;"
                  data-bs-toggle="tooltip"
                  data-bs-placement="bottom"
                  data-bs-title="{{ supplier.name }}"
                >
              </a>
            </div>
          {% endfor %}
      </div>
      <div class="col-md-4">
        {% for n in 0..4 %}
          <h6 class="py-2 px-5 fs-6 ">
            {{ continents[n] }}
          </h6>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
<div class="p-2 d-none" id="models-menu">
  <div class="d-flex">
  </div>
</div>