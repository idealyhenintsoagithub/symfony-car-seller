{% extends 'base.html.twig' %}

{% block title %}Pannier{% endblock %}

{% block body %}
  <div class="container">
    {% if message %}
      {% set alertColor = status|default('success') == 'success' ? 'alert-success' : 'alert-danger'  %}
      <div class="alert {{ alertColor }} mt-4 d-flex justify-content-between">
        {{ message|default('') }}
        <button 
            type="button" 
            class="btn-close" 
            data-bs-dismiss="alert" 
            aria-label="Close"
        ></button>
      </div>
    {% endif %}
    <div class="row mt-4">
      <h1>Fiche produit</h1>
    </div>
    {{ form_start(form) }}
      <div class="row">
        <div class="col-sm-8 order-container">
          <div class="row justify-content-end p-4">
            <div class="col-sm-3">
                {{ form_widget(form.save) }}
            </div>
            <div class="col-sm-2">
                {{ form_widget(form.clear) }}
            </div>
          </div>
          {% if cart.orderItems.count > 0 %}
            {% for orderItem in form.orderItems %}
              <div class="d-flex mb-5 align-items-center order-item bg-white p-4 rounded-2">
                <div class="order-item-media">
                  <img 
                    src="{{ asset('/images/products/' ~ orderItem.vars.data.product.image ) }}" 
                    alt="{{ orderItem.vars.data.product.image }}"
                  >
                </div>
                <div class="order-item-content">
                    <div class="d-flex justify-content-between">
                        <p class="product-name">
                            {{ orderItem.vars.data.product.title }}
                        </p>
                        <p class="product-price">
                            <i class="bi bi-currency-dollar"></i>
                            {{ orderItem.vars.data.product.priceTtc }}
                        </p>
                    </div>
                    <div class="d-flex justify-content-between">
                        <p class="product-name">
                            Nombre de produit
                        </p>
                        <p class="product-price">
                            {{ orderItem.vars.data.quantity }}
                        </p>
                    </div>
                    <div class="d-flex justify-content-between">
                        <p class="product-name">
                            Total
                        </p>
                        <p class="product-price">
                            <i class="bi bi-currency-dollar"></i>
                            {{ orderItem.vars.data.product.priceTtc * orderItem.vars.data.quantity }}
                        </p>
                    </div>
                    <div class="order-description">
                      {{ orderItem.vars.data.product.description }}
                    </div>
                    <div class="mt-2 d-flex">
                      {{ form_widget(orderItem.quantity) }}
                      {{ form_widget(orderItem.remove) }}
                    </div>
                </div>
              </div>
            {% endfor %}
          {% else %}
              <div class="text-center">
                  <h3>Pannier vide</h3>
              </div>
          {% endif %}
        </div>
        <div class="col-sm-4 cart-detail-container p-4 rounded-4 bg-white d-flex flex-column justify-content-between">
          <div>
              <h4>Detail du pannier</h4>
              <div class="d-flex justify-content-between">
                <p>Total</p>
                <p>
                  <i class="bi bi-currency-dollar"></i>
                  {{ cart.getTotal }}
                </p>
              </div>
          </div>
          <div>
            <a 
              href={{ cart.orderItems.count > 0 ? path('app_validate_cart') : '#' }} 
              role="button" 
              class="btn btn-success w-100 fw-bold text-center text-uppercase text-white"
              {{ cart.orderItems.count > 0 ? 'disabled' : '' }}
            >
              Acheter
            </a>
          </div>
        </div>
      </div>
    {{ form_end(form) }}
  </div>
{% endblock %}
