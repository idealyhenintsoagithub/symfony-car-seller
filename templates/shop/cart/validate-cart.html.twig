{% trans_default_domain 'messages' %}

{% extends 'base.html.twig' %}

{% block title %}Pannier{% endblock %}

{% block body %}
    <div class="container">
        <div class="mt-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item fw-semibold"><a href="#">Home</a></li>
                    <li class="breadcrumb-item fw-semibold"><a href="#">Shop</a></li>
                    <li class="breadcrumb-item active fw-semibold" aria-current="page">Checkout</li>
                </ol>
            </nav>
        </div>
        <div class="row my-5">
            <h4>Validation de l'achat</h4>
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-7">
                <div class="border-bottom my-3 pb-4">
                    {% include 'shop/cart/delivery-address.html.twig' %}
                </div>
                <div class="border-bottom my-3 pb-4">
                    {% include 'shop/cart/delivery-instruction.html.twig' %}
                </div>
                <div class="border-bottom my-3 pb-4">
                    {% include 'shop/cart/payment-method.html.twig' %}
                </div>
            </div>
            <div class="col-sm-12 col-md-4 offset-lg-1 p-0 mt-sm-3 mt-lg-0">
                <ul class="list-group shadow-sm">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        A list item
                        <span class="badge bg-primary rounded-pill">14</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        A second list item
                        <span class="badge bg-primary rounded-pill">2</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        A third list item
                        <span class="badge bg-primary rounded-pill">1</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
