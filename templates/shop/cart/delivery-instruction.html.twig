<div class="d-flex justify-content-between">
    <a
        class="btn btn-link text-decoration-none fs-5 fw-semibold text-dark"
        data-bs-toggle="collapse"
        href="#deliveryInstruction"
        role="button"
        aria-expanded="false"
        aria-controls="deliveryInstruction"
    >
        <i class="bi bi-journal-minus pe-2"></i>
        {{ 'validationCard.title.deliveryInstruction'|trans }}
    </a>
</div>
<div class="collapse multi-collapse" id="deliveryInstruction">
    <div class="card card-body">
        <form>
            <div class="mb-3">
                <label for="deliveryInstructions" class="form-label fw-semibold">Delivery instructions</label>
                <textarea
                    class="form-control border rounded-3"
                    id="deliveryInstructions"
                    rows="4"
                    placeholder="Write delivery instructions"
                ></textarea>
                <div class="form-text text-muted mt-1">
                    Add instructions for how you want your order shopped and/or delivered
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary">Prev</button>
                <button type="submit" class="btn btn-success fw-bold">Next</button>
            </div>
        </form>
    </div>
</div>