{% extends 'base.html.twig' %}

{% trans_default_domain 'messages' %}

{% block title %}Product page{% endblock %}

{% block body %}
    <div id="bannier">
        <img src="{{ asset('images/rover.jpg') }}" alt="Symfony!"/>
        <div class="presentation-text">
            <h2>{{ 'home.title.pageTitle'|trans }}</h2>
        </div>
    </div>
    <div class="container-fluid product-page">
        <div class="pt-4">
            <h4 class="text-center">
                {{ 'home.label.buyOnline'|trans }}
            </h4>
        </div>
        
        {{ include('shop/home/car-brand.html.twig') }}

        <div class="row product-list-container gutter-3" id="product-list-container">
            {% for product in products %}
                {{ include('shop/home/product-item.html.twig', { product: product }) }}
            {% endfor %}
        </div>
    </div>
    <script>
        var shouldScroll = '{{ shouldScroll }}'
    </script>
{% endblock %}
