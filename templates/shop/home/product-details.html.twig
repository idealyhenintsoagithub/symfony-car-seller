{% extends 'base.html.twig' %}

{% block title %}Detail du produit{% endblock %}

{% block body %}
  <div class="container-fluid mt-5 row">
    <div class="col"></div>

    <div class="col-sm-7">
      <img 
        src={{ asset("images/products/" ~ product.image ) }} 
        alt={{ product.image }} 
        width="500"
        style="border-radius: 8px;"
      >
      <div class="d-flex">
        {% for item in 0..4 %}
          <div class="m-2 bg-white rounded-3 p-1">
            <img 
              src={{ asset("images/products/" ~ product.image ) }} 
              alt={{ product.image }} 
              width="100"
              height="100"
              style="border-radius: 8px; object-fit: contain;"
            >
          </div>
        {% endfor %}
      </div>
    </div>
    
    <div class="col-sm-3 bg-white p-4 rounded-4">
      <h2>{{ product.title }}</h2>
      <div class="fw-bold py-2">
        <i class="bi bi-currency-dollar"></i>
        {{ product.priceTtc }}
      </div>
      <div>{{ product.description }}</div>
      <div class="d-flex py-2">
        {{ form_start(form) }}
          <div class="d-flex mt-4">
            <div>
              {{ form_widget(form.quantity, { 'attr': { 'class': 'form-control', 'max': product.stock}}) }}
              {{ form_errors(form.quantity) }}
            </div>
            <div class="ml-2">
              {{ form_widget(form.add, { 'attr': { 'class': 'btn btn-success' }}) }}
            </div>
          </div>
        {{ form_end(form) }}
      </div>
    </div>

    <div class="col"></div>
  </div>
  <div class="container mt-4">
    <h5 class="text-center py-3">Autre produits</h5>
    <div class="container">
      <div class="row">
      {% if relativeProducts %}
        {% for product in relativeProducts %}
          {{ include("shop/home/product-item.html.twig", { product: product }) }}
        {% endfor %}
      {% else %}
        <h5 class="text-center">Aucune produits relative</h5>
      {% endif %}
      </div>
    </div>
  </div>
{% endblock %}