
<div class="col-sm-3 product-item mb-4">
  <div class="product-item-content rounded-3 bg-white h-100">
    <a href={{ path("product_detail", { id: product.id }) }} class="text-decoration-none">
      <img
        src={{ asset(product.image ? "images/products/" ~ product.image : "images/rover.jpg") }}
        alt="{{ product.image }}"
        style="height: 200px; width: 100%; object-fit: cover;"
        class="rounded-3"
      />
      <div class="p-3 h-100">
        <h6 class="pt-4">{{ product.title }}</h6>
        <div class="py-1">
          {{ product.description }}
        </div>
        <div class="py-2 d-flex justify-content-between">
          <div class="d-flex align-items-center fw-bold">
            <i class="bi bi-currency-euro fs-6"></i>
            <div>{{ product.priceTtc }}</div>
          </div>
          <a href={{ path("product_detail", { id: product.id }) }} class="d-flex align-items-center text-primary">
            Voir plus
          </a>
        </div>
      </div>
    </a>
  </div>
</div>

